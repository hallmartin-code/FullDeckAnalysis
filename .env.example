# Copy to .env for local development. Never commit real keys.
# On Railway, set these in the service's Variables tab instead.

# --- Analysis provider (set at least one, or the app falls back to the
# --- offline heuristic reviewer, which needs no credentials) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Optional model overrides ---
DECK_REVIEW_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-4o

# --- Web app ---
# Shared secret required to submit a deck. STRONGLY recommended for any public
# deployment: without it, anyone with the URL can spend your API credits.
ACCESS_CODE=

# PORT is injected by Railway; only set it locally if you want a specific port.
# PORT=8000

# --- Email notifications (Resend) ---
# Every completed review is emailed with the PDF and JSON attached.
# Leave RESEND_API_KEY empty to disable emailing entirely.
RESEND_API_KEY=
REPORT_EMAIL_TO=Info@tencapital.group
# The from-domain must be verified in the Resend dashboard.
REPORT_EMAIL_FROM=TEN Capital Deck Review <reports@tencapital.group>
# REPORT_EMAIL_CC=
# REPORT_EMAIL_REPLY_TO=
# REPORT_EMAIL_ATTACH_PDF=true
# REPORT_EMAIL_ATTACH_JSON=true
